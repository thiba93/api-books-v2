NODE_ENV=development
PORT=3000

# Base Neon partagee par les 3 postes.
# Remplacer USER, PASSWORD et HOST par la chaine fournie dans le dashboard Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/api_books_v2?sslmode=require&channel_binding=require"

# Changer cette valeur avant tout deploiement.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

CORS_ORIGIN="http://localhost:5173"
