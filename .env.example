NODE_ENV=development
PORT=3000

# PostgreSQL local sans Docker.
# Creer la base api_books_v2 dans PostgreSQL puis copier ce fichier en .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_books_v2?schema=public"

# Changer cette valeur avant tout deploiement.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

CORS_ORIGIN="http://localhost:5173"
